meta {
  name: getall
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/workspace/me?limit=1&cursor={{nextCursor}}
  body: none
  auth: bearer
}

params:query {
  limit: 1
  cursor: {{nextCursor}}
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  const body = res.getBody();
  
  bru.setEnvVar("nextCursor", body.data.nextCursor);
}

settings {
  encodeUrl: true
  timeout: 0
}
