meta {
  name: getall
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/threshold/metric/26f6137e-60c7-4fd1-a9af-18108df9028a?limit=1
  body: none
  auth: bearer
}

params:query {
  limit: 1
  ~cursor: {{nextCursor}}
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  const body = res.getBody();
  
  bru.setEnvVar("nextCursor", body.data?.nextCursor);
}

settings {
  encodeUrl: true
  timeout: 0
}
