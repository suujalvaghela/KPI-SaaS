meta {
  name: getall-workspaces
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/member/user/abfb6529-e507-470c-a7ac-a9f1c3b0761f?limit=1
  body: none
  auth: bearer
}

params:query {
  limit: 1
  ~cursor: {{nextCursor}}
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  const body = res.getBody();
  
  bru.setEnvVar("nextCursor", body.data?.nextCursor);
}

settings {
  encodeUrl: true
  timeout: 0
}
